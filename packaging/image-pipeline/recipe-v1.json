{
  "schema": 1,
  "recipe_id": "https://github.com/pgsty/barn/packaging/image-pipeline/v1",
  "max_source_bytes": 17179869184,
  "max_package_bytes": 536870912,
  "max_package_bundle_bytes": 1073741824,
  "copy_chunk_bytes": 8388608,
  "timeouts_seconds": {
    "qemu_img": 120,
    "virt_customize": 1800,
    "virt_cat": 300
  },
  "qemu_img_contract": {
    "inspect": [
      "info",
      "--output=json",
      "-f",
      "qcow2"
    ],
    "inspect_chain": [
      "info",
      "--output=json",
      "--backing-chain",
      "-f",
      "qcow2"
    ],
    "check": [
      "check",
      "--output=json",
      "-f",
      "qcow2"
    ],
    "required_format": "qcow2",
    "required_chain_length": 1,
    "reject_truthy_fields": [
      "backing-filename",
      "full-backing-filename",
      "backing-filename-format",
      "data-file",
      "encrypted",
      "incompatible-features",
      "extended-l2",
      "corrupt",
      "dirty-flag"
    ]
  },
  "normalization": {
    "engine": "virt-customize",
    "network": false,
    "guest_script": "normalize-guest.sh",
    "marker": "/var/lib/barn-image/normalization.json",
    "login_user": "dba",
    "login_uid": 88,
    "primary_group": "admin",
    "primary_gid": 88,
    "password_authentication": false,
    "remove_authorized_keys": true,
    "remove_private_ssh_keys": true,
    "remove_ssh_host_keys": true,
    "clear_machine_id": true,
    "clear_cloud_init_cache": true,
    "locale_policy": {
      "available": ["C.UTF-8", "en_US.UTF-8"],
      "default": "C.UTF-8",
      "profiles": ["d12", "d13"]
    },
    "profiles": {
      "base": {
        "locked_packages": [],
        "package_format": null,
        "required_packages": []
      },
      "el8": {
        "locked_packages": ["python36", "python3-pip"],
        "package_format": "rpm",
        "required_packages": ["python36", "python3-pip"]
      },
      "el9": {
        "locked_packages": [],
        "package_format": null,
        "required_packages": []
      },
      "d12": {
        "locked_packages": ["libinih1", "liburcu8", "xfsprogs"],
        "package_format": "deb",
        "required_packages": ["xfsprogs"]
      },
      "d13": {
        "locked_packages": ["libicu76", "libinih1", "xfsprogs"],
        "package_format": "deb",
        "required_packages": ["xfsprogs"]
      }
    }
  },
  "promotion_policy": {
    "candidate_status": "testing",
    "supported_status_allowed": false,
    "production_signing": false,
    "native_smoke_required_after_build": true
  }
}
